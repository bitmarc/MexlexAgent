# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://<tu-recurso>.openai.azure.com/
AZURE_OPENAI_API_KEY=<tu-api-key>
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=<nombre-de-tu-deployment-de-chat>
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=<nombre-de-tu-deployment-de-embeddings>

# --- Azure AI Search ---
AZURE_SEARCH_ENDPOINT=https://<tu-servicio>.search.windows.net
AZURE_SEARCH_API_KEY=<tu-admin-key>
# El esquema del índice (campos filtrables) solo se aplica al CREARLO.
# Para cambiar la estructura, apunta a un nombre nuevo y reindexa.
AZURE_SEARCH_INDEX_NAME=mexlex-index-v2

# --- Semantic ranking ---
# La configuración semántica se crea junto con el índice; déjala puesta
# aunque no la uses todavía, o activarla después obligaría a reindexar.
AZURE_SEARCH_SEMANTIC_CONFIG_NAME=mexlex-semantic-config
# Si el retriever USA el semantic ranker. Disponible en el tier gratuito
# F0 bajo el plan Free (cuota mensual de consultas); requiere que la
# región del servicio lo soporte. Ojo: reordena los top 50 del ranking
# base, así que NO ayuda a localizar un artículo por número.
AZURE_SEARCH_USE_SEMANTIC_RANKER=false

# Dimensión del vector de embeddings. Vacío = se detecta sola
# (text-embedding-3-large = 3072, -small = 1536).
# EMBEDDING_DIMENSIONS=3072

# --- Cosmos DB / persistencia del historial (Fase 7, opcional) ---
# Sin endpoint el historial vive en memoria y se pierde al reiniciar.
# API for NoSQL. El contenedor DEBE tener la partition key /partition_key.
AZURE_COSMOS_ENDPOINT=https://<tu-cuenta>.documents.azure.com:443/
# Vacío = DefaultAzureCredential (Managed Identity / az login). Ojo: con
# Entra ID hace falta el rol de PLANO DE DATOS
# (`az cosmosdb sql role assignment create`), no el IAM del portal.
AZURE_COSMOS_KEY=<tu-primary-key>
AZURE_COSMOS_DATABASE=mexlex
AZURE_COSMOS_CONTAINER=checkpoints
# Contenedor de la UI (Fase 8): hilos, mensajes y usuarios de Chainlit.
AZURE_COSMOS_THREADS_CONTAINER=conversations
# Retención en segundos. Vacío = para siempre. 2592000 = 30 días.
# Solo aplica si el contenedor lo crea el código.
# AZURE_COSMOS_TTL_SECONDS=2592000
# false si el identity solo tiene permisos de plano de datos (entonces
# la base y el contenedor tienen que existir de antemano).
AZURE_COSMOS_CREATE_IF_MISSING=true

# --- Autenticación de la UI (Fase 8, opcional) ---
# Sin usuario y contraseña la app corre sin login: funciona igual, pero
# no hay barra lateral con las conversaciones anteriores. Chainlit solo
# persiste hilos cuando sabe de quién son.
# ⚠️ Cuenta única de desarrollo, no un sistema de usuarios: la
# contraseña va en claro. Para algo real usa OAuth (Entra ID).
MEXLEX_AUTH_USER=<tu-usuario>
MEXLEX_AUTH_PASSWORD=<tu-contraseña>
# Secreto para firmar la cookie de sesión. Genéralo con:
#   chainlit create-secret
CHAINLIT_AUTH_SECRET=<pega-aquí-el-secreto-generado>

# --- LangSmith / trazabilidad (Fase 6, opcional) ---
# Sin API key el tracing queda apagado y la app funciona igual.
# Consigue una key gratuita en https://smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=<tu-api-key-de-langsmith>
LANGSMITH_PROJECT=mexlex-agent

# --- Tavily / búsqueda web (Fase 4, opcional) ---
# Sin esta key el agente corre solo con el corpus indexado, sin salir a
# internet. Key gratuita en https://tavily.com
TAVILY_API_KEY=<tu-api-key-de-tavily>
